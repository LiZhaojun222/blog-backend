<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.lzhao.blog.mapper.TagMapper">

    <resultMap id="BaseResultMap" type="org.lzhao.blog.entity.Tag">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, create_time
    </sql>

    <!-- 查询所有标签 -->
    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM tag
        ORDER BY id ASC
    </select>

    <!-- 根据 ID 查询 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM tag
        WHERE id = #{id}
    </select>

    <!-- 根据名称查询 -->
    <select id="findByName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM tag
        WHERE name = #{name}
    </select>

    <!-- 新增标签 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tag (name) VALUES (#{name})
    </insert>

    <!-- 删除标签 -->
    <delete id="deleteById">
        DELETE FROM tag WHERE id = #{id}
    </delete>

    <!-- 查询某篇文章的标签 -->
    <select id="findByArticleId" resultMap="BaseResultMap">
        SELECT t.id, t.name, t.create_time
        FROM tag t
                 INNER JOIN article_tag at ON t.id = at.tag_id
        WHERE at.article_id = #{articleId}
    </select>

    <!-- 给文章添加标签 -->
    <insert id="insertArticleTag">
        INSERT INTO article_tag (article_id, tag_id)
        VALUES (#{articleId}, #{tagId})
    </insert>

    <!-- 删除文章的所有标签 -->
    <delete id="deleteArticleTags">
        DELETE FROM article_tag WHERE article_id = #{articleId}
    </delete>

</mapper>